{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgewire.invalid/schemas/authorization-file/v1.json",
  "title": "Bridgewire authorization rows",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["KEY", "NAME", "ALLOW"],
    "properties": {
      "KEY": {
        "type": "string",
        "pattern": "^(?:[0-9A-Fa-f]{2}-?){5}$"
      },
      "NAME": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "ALLOW": {
        "type": "string",
        "pattern": "^[YyNn]$"
      }
    }
  }
}

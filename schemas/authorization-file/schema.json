{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgewire.invalid/schemas/authorization-file/v1.json",
  "title": "Bridgewire authorization rows",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["KEY", "NAME", "ALLOW"],
    "properties": {
      "KEY": {
        "type": "string",
        "pattern": "^(?:[0-9A-Fa-f]{10}|[0-9A-Fa-f]{2}(?:-[0-9A-Fa-f]{2}){4})$"
      },
      "NAME": {
        "type": "string",
        "pattern": "^(?=.*\\S).+$",
        "maxLength": 120
      },
      "ALLOW": {
        "type": "string",
        "pattern": "^[YyNn]$"
      }
    }
  }
}
